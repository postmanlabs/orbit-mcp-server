# orbit-mcp-server configuration. All variables are optional; defaults are shown.
# Copy to `.env` for local development.

# --- Transport ---------------------------------------------------------------
# How the server talks to MCP clients: "stdio" or "http" (Streamable HTTP).
ORBIT_MCP_TRANSPORT=stdio

# HTTP transport bind address + port (ignored for stdio).
ORBIT_MCP_HOST=127.0.0.1
SERVICE_PORT=8080

# --- Upstream (public Orbit gateway) -----------------------------------------
ORBIT_GATEWAY_BASE_URL=https://api.buildwithorbit.ai
ORBIT_SEARCH_PATH=/v1/search
ORBIT_INTEGRATE_PATH=/v1/integrate

# Timeouts (seconds).
ORBIT_SEARCH_TIMEOUT_SECONDS=60
ORBIT_INTEGRATE_TIMEOUT_SECONDS=60
ORBIT_CONNECT_TIMEOUT_SECONDS=10

# --- Logging -----------------------------------------------------------------
ORBIT_LOG_LEVEL=info
ORBIT_LOG_PRETTY=false
